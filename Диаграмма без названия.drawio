<mxfile host="app.diagrams.net">
  <diagram name="Страница-1" id="uxuwC6pHA39uhbIi0HK2">
    <mxGraphModel dx="2946" dy="2813" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;mindmap\n  root((Стул))\n    Beta Testing\n      Отдать коту, пусть дерет\n      Пусть дети попрыгают\n      Дать посидеть теще\n    Automated Testing\n      Робот-пылесос под ним проезжает\n      Автоматический подъем сиденья\n    Validation\n      На улице и в доме?\n      В бане при 100% влажности?\n      При морозе -30 на балконе?\n      При переезде в грузовике?\n    Verification\n      Ножки ровные или одна короче?\n      Высота соответствует ГОСТу?\n      Материал или просто ДСП?\n      Резьба на шурупах в порядке?\n    Security Testing\n      Углы острые?\n      Краска токсичная?\n      Выдержит ли вес, не развалится?\n    Negative Testing\n      Встать на него ногами!\n      Качаться на задних ножках!\n      Пролить на него борщ/кофе\n      Стукнуть по нему кулаком\n    Stress Testing\n      Уронить с 5 этажа\n      Попрыгать на нем весом 150 кг\n      Поставить сверху шкаф\n      Попытаться согнуть спинку\n    Documentation Testing\n      Инструкция по сборке ИКЕА понятная?\n      Все ли болтики нарисованы?\n    UI Testing\n      Какого цвета обивка?\n      Подходит ли по интерьеру?\n      Есть ли узоры?\n    Entry Point Testing\n      Новый, в коробке\n      Б/У, уже на нем сидели\n    Black Box Testing\n      Неизвестно из чего собран\n      Действуем вслепую\n    Functional Testing\n      Сидеть можно?\n        Держит ли вес?\n        А если на край сесть?\n      Спинка поддерживает?\n      Можно ли переносить?\n    Usability Testing\n      Удобно сидеть?\n      Удобно вставать?\n      Пятая точка не затекает?\n      Спина не устает за 8 часов?\n    Compatibility Testing\n      Напольные покрытия\n        На линолеуме?\n        На ковре?\n        На плитке?\n      Пользователи\n        Ребенок?\n        Взрослый дядя?\n        Кот?\n      Места использования\n        Кухня\n        Офис\n        Балкон\n    Performance Testing\n      Сколько выдержит килограмм?\n      Сколько прослужит до поломки?\n      Какой срок годности у пластика?\n    Component Testing\n      Отдельно проверяем сиденье\n      Отдельно проверяем ножки\n      Отдельно проверяем спинку\n    Integration testing\n      Собрали, шатается или нет?\n      Стул стоит ровно на 4-х ножках?&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="xhx8HaWPCrS8R3CGRwtR-1">
